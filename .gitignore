# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/
build/
dist/

# Data: only the README and the sample DEM are versioned (IGC files are personal data)
data/*
!data/README.md
# data/dem/: sample/ holds the versioned sample DEM archive, cop30/ your own larger extracts
!data/dem/
data/dem/*
!data/dem/README.md
!data/dem/sample/
data/dem/sample/*
!data/dem/sample/rasters_COP30_sample.tar.gz
# data/igc/: your own IGC tracks for training; only its README is versioned
!data/igc/
data/igc/*
!data/igc/README.md
# safety net: never version an IGC track, wherever it is
*.[iI][gG][cC]

# Generated outputs
models/*.npz
models/local/
*.html
!src/cheminee/web/static/index.html
flight.json
emagram.png
forecast.json

# Editors and OS
.vscode/
.idea/
.DS_Store
.env
